# Copy this file to keystore.properties (repo root, same level as this file)
# and fill in your own values. keystore.properties is gitignored - never
# commit it or the keystore file itself.
#
# storeFile may be absolute, or relative to the repo root.

storeFile=/absolute/path/to/your/release.keystore
storePassword=changeit
keyAlias=kotonote
keyPassword=changeit
