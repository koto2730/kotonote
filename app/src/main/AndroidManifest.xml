<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      kotonote is an offline-only app: android.permission.INTERNET is deliberately
      NOT declared, so the app is technically incapable of network access.
      kotonote は完全オフラインのアプリです。INTERNET 権限は意図的に宣言していません。
    -->

    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!--
      Backup: allowBackup stays true only so that Android's device-to-device transfer (moving to a
      new phone) can carry the notes over. Cloud backup is switched off for everything in
      data_extraction_rules.xml (Android 12+) and backup_rules.xml (Android 11 and older), so
      nothing is uploaded to the user's Google account. kotonote itself never transmits anything.
      機種変更時の端末間移行のためだけに allowBackup を true にしている。クラウドバックアップは
      ルールファイルで全て除外している。
    -->
    <application
        android:name=".KotonoteApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Kotonote"
        tools:targetApi="33">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Share a picture or a video (a screenshot, say) into a note. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />

                <category android:name="android.intent.category.DEFAULT" />

                <data android:mimeType="image/*" />
                <data android:mimeType="video/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />

                <category android:name="android.intent.category.DEFAULT" />

                <data android:mimeType="image/*" />
                <data android:mimeType="video/*" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.ImageViewerActivity"
            android:exported="false"
            android:theme="@style/Theme.Kotonote" />

        <activity
            android:name=".ui.VideoPlayerActivity"
            android:exported="false"
            android:theme="@style/Theme.Kotonote" />

        <activity
            android:name=".ui.PaintActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.Kotonote" />

        <!-- Hands attachment files to the camera and to share targets; nothing else. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
