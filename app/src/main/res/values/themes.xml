<resources>
    <style name="Theme.Kotonote" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/slate_600</item>
        <item name="colorPrimaryVariant">@color/slate_800</item>
        <item name="colorOnPrimary">@color/white</item>
        <!-- 朱: the one accent, used by the action buttons and dialog buttons. -->
        <item name="colorSecondary">@color/vermilion_600</item>
        <item name="colorSecondaryVariant">@color/vermilion_700</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="alertDialogTheme">@style/Theme.Kotonote.AlertDialog</item>
    </style>

    <!-- Dialog buttons use the 朱 accent so they stay legible on the dark surface. -->
    <style name="Theme.Kotonote.AlertDialog" parent="ThemeOverlay.MaterialComponents.Dialog.Alert">
        <item name="colorPrimary">?attr/colorSecondary</item>
        <item name="colorAccent">?attr/colorSecondary</item>
    </style>
</resources>
