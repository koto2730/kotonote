<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 11 and older only use Auto Backup (cloud), so excluding everything means nothing is
  uploaded. Consequence: on those versions the notes are not carried to a new phone.
-->
<full-backup-content>
    <exclude domain="root" />
    <exclude domain="file" />
    <exclude domain="database" />
    <exclude domain="sharedpref" />
</full-backup-content>
