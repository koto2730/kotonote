<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+.
  - cloud-backup: nothing. Notes are never uploaded to the user's Google account.
  - device-transfer: the database, the attachment files and the preferences, so that moving to a
    new phone with Android's device-to-device transfer brings the notes along. That transfer
    runs between the two phones; the app itself transmits nothing.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="." />
        <include domain="file" path="notes" />
        <include domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
